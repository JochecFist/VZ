\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Ilustrace umělého neuronu. Do neuronu se vkládá \textbf  {n} počet vstupních vektorů \textbf  {A} s~odpovídajícími váhovými hodnotami \textbf  {w}. Neuron zpracovává vstup tak, že vypočítá vážený součet vstupů s~odpovídajícími vahami a~přidá váhu zkreslení (b): x-w+b. Výsledný vzorec se vloží do aktivační funkce (g), jejíž hodnota určuje výstup neuronu.\cite  {Ghorbani2021}}}{27}{figure.2.1}\protected@file@percent }
\newlabel{obrNeuron}{{2.1}{27}{Ilustrace umělého neuronu. Do neuronu se vkládá \textbf {n} počet vstupních vektorů \textbf {A} s~odpovídajícími váhovými hodnotami \textbf {w}. Neuron zpracovává vstup tak, že vypočítá vážený součet vstupů s~odpovídajícími vahami a~přidá váhu zkreslení (b): x-w+b. Výsledný vzorec se vloží do aktivační funkce (g), jejíž hodnota určuje výstup neuronu.\cite {Ghorbani2021}}{figure.2.1}{}}
